{
  "rewrites": [
    { "source": "/api/whales", "destination": "/api/whales.js" },
    { "source": "/cards", "destination": "/cards.html" },
    { "source": "/thetrench", "destination": "/thetrench.html" },
    { "source": "/api/leaderboard", "destination": "/api/leaderboard.js" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ]
}
